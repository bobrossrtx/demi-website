// ========================================
// DEMI WEBSITE - THEME VARIABLES
// ========================================

// Color Palette
// ----------------------------------------
// Primary Colors
$primary-color: #ffc832;           // Primary accent (gold/yellow)
$primary-hover: #5cabff;           // Primary hover state
$primary-blue: #1888ff;            // Primary blue

// Background Colors
$bg-dark: #282828;                 // Dark background
$bg-gradient-start: #61667b;       // Gradient start color
$bg-gradient-end: #373a47;         // Gradient end color
$bg-primary-gradient: linear-gradient(to bottom right, $bg-gradient-start 20%, $bg-gradient-end);
$bg-navbar: linear-gradient(90deg, $bg-dark 0%, $bg-dark 100%);

// Text Colors
$text-primary: #fff;               // Primary text color (white)
$text-dark: #000;                  // Dark text
$text-secondary: #ffc832;          // Secondary text (matches primary color)

// Alert/Warning Colors
$warning-bg: #fff3cd;              // Warning background
$warning-border: #ffeeba;          // Warning border
$warning-text: #856404;            // Warning text

// Success Colors
$success-bg: #a1dc75;              // Success background
$success-text: #000;               // Success text

// Border Colors
$border-dark: #444;                // Dark borders
$border-light: #ffeeba;            // Light borders

// Shadow Colors
$shadow-black: #000000;            // Black shadow
$shadow-color: rgba(0, 0, 0, 0.5); // Shadow with opacity

// Sidebar Colors
$sidebar-bg: $bg-dark;             // Sidebar background
$sidebar-hover: #444;              // Sidebar hover state

// Tag Colors
$tag-bg: #f0f0f0;                  // Tag background
$tag-color: $bg-dark;              // Tag text color

// Link Colors
$link-color: $primary-color;       // Default link color
$link-hover: $bg-gradient-start;   // Link hover color

// Spacing
// ----------------------------------------
$spacing-xs: 5px;
$spacing-sm: 8px;
$spacing-md: 10px;
$spacing-lg: 15px;
$spacing-xl: 20px;
$spacing-2xl: 25px;
$spacing-3xl: 30px;

// Margins
$margin-xs: 0.5rem;
$margin-sm: 1rem;
$margin-md: 1.5rem;
$margin-lg: 2rem;
$margin-xl: 10em;

// Padding
$padding-xs: 5px;
$padding-sm: 10px;
$padding-md: 15px;
$padding-lg: 16px;
$padding-xl: 30px;

// Typography
// ----------------------------------------
// Font Families
$font-family-primary: 'PT Sans', sans-serif;

// Font Sizes
$font-size-xs: 14px;
$font-size-sm: 16px;
$font-size-md: 18px;
$font-size-lg: 20px;
$font-size-xl: 1.2rem;
$font-size-2xl: 1.5rem;
$font-size-3xl: 1.6rem;
$font-size-4xl: 2rem;

// Font Weights
$font-weight-normal: normal;
$font-weight-bold: bold;
$font-weight-semi-bold: 600;

// Layout
// ----------------------------------------
// Widths
$width-full: 100%;
$width-container: 80vw;
$width-nav-menu: 70vw;
$width-dropdown: 200px;
$width-icon: 2em;
$width-logo: 50px;

// Heights
$height-navbar: 80px;
$height-nav-link: 35px;
$height-doc-nav: 50px;
$height-button-container: 4em;
$height-logo: 50px;
$height-full-vh: 100vh;

// Sidebar Dimensions
$sidebar-width: 15vw;
$sidebar-min-width: 220px;
$sidebar-max-width: 300px;

// Border Radius
// ----------------------------------------
$border-radius-sm: 4px;
$border-radius-md: 5px;
$border-radius-lg: 50em;

// Borders
// ----------------------------------------
$border-width-sm: 1px;
$border-width-md: 12px;
$border-style: solid;

// Transitions
// ----------------------------------------
$transition-fast: 0.3s ease;
$transition-ease-out: 0.3s ease-out;
$transition-ease-in-out: 0.3s ease-in-out;

// Z-Index
// ----------------------------------------
$z-index-navbar: 100;
$z-index-sidebar: 9;
$z-index-footer: 100;

// Shadows
// ----------------------------------------
$box-shadow-neon: 0 0 70px 15px $shadow-black;

// Gaps
// ----------------------------------------
$gap-xs: 10px;
$gap-sm: 25px;
$gap-md: 50px;

// Breakpoints
// ----------------------------------------
$breakpoint-mobile: 768px;
$breakpoint-tablet: 960px;
$breakpoint-desktop: 1200px;
$breakpoint-large: 1600px;
